up:
    git pull --rebase

# test everything but at first failure stop
test:
    echo "" > pytest.log
    just test-base
    just test-extras 
    just test-amspy
    just ruff

# make all the tests
test-all:
    echo "" > pytest.log
    -just test-base
    -just test-extras 
    -just test-amspy
    -just ruff

# temporary test only the ams interface, used before pushing
test-amsruff:
    echo "" > pytest.log
    # one test currently failing...
    just test-amspy
    just ruff

# I should add some extra testing conditions based on optional dependencies
test-base:
    uv run --isolated coverage run --source='scm.moliterate' -m pytest tests | tee -a pytest.log
    just coverage-readme "test-base" 2
    just log-look

# test with all extras
test-extras:
    uv run --isolated --dev --extra tutorial --extra apricot --extra mace --extra chem coverage run --source='scm.moliterate' -m pytest tests | tee -a pytest.log
    just coverage-readme "test-extras" 1
    just log-look

