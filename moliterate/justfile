test-amspy-spec file='test_partition_criteria_2d.py':
    #!/usr/bin/env bash
    source .env
    source $AMSBASHRCPATH
    echo $AMSHOME
    amspython -m pip install --upgrade pip
    amspython -m pip install uv
    amspython -m uv pip install --group dev -e .[chem,mace,apricot,tutorial,viz]
    amspython -m uv pip install "plams @ git+https://github.com/SCM-NV/PLAMS"
    amspython -m pytest tests/{{ file }} | tee -a pytest.log
    echo "pytest.log"
    tail "pytest.log"

log-look:
    echo "pytest.log"
    tail "pytest.log"

ruff:
    just ruff-lint
    just ruff-format

ruff-lint:
    uvx ruff check ./src/

ruff-format:
    uvx ruff format --check ./src/

# look at https://docs.astral.sh/ruff/formatter/#sorting-imports
ruff-format-do:
    uvx ruff check --select I --fix
    uvx ruff format ./src/
    uvx ruff format ./tests

# update README coverage line (CI-friendly)
coverage-readme test='NotFound' test_index='0':
    uv run --isolated --with=coverage coverage json -o coverage.json
    uv run --isolated python scripts/update_readme_coverage.py --json coverage.json --pytest-log pytest.log --readme README.md --test {{ test }} --test-index {{ test_index }}
